{"duration": 12.32, "cues": [{"start": 0.0, "end": 4.59, "text": "Shark scientist Enrico Gennari and his\nco-authors said great white sightings"}, {"start": 4.59, "end": 8.938, "text": "in False Bay had started falling\naround 2012. That was about three years"}, {"start": 8.938, "end": 12.32, "text": "before Port and Starboard\nwere first seen hunting there."}], "words": [{"start": 0.0, "end": 0.28, "text": "Shark"}, {"start": 0.28, "end": 0.76, "text": "scientist"}, {"start": 0.76, "end": 1.52, "text": "Enrico"}, {"start": 1.52, "end": 1.9, "text": "Gennari"}, {"start": 1.9, "end": 2.36, "text": "and"}, {"start": 2.36, "end": 2.5, "text": "his"}, {"start": 2.5, "end": 2.72, "text": "co"}, {"start": 2.72, "end": 3.08, "text": "-authors"}, {"start": 3.08, "end": 3.48, "text": "said"}, {"start": 3.48, "end": 4.04, "text": "great"}, {"start": 4.04, "end": 4.32, "text": "white"}, {"start": 4.32, "end": 4.64, "text": "sightings"}, {"start": 4.64, "end": 5.0, "text": "in"}, {"start": 5.0, "end": 5.2, "text": "False"}, {"start": 5.2, "end": 5.5, "text": "Bay"}, {"start": 5.5, "end": 5.66, "text": "had"}, {"start": 5.66, "end": 5.96, "text": "started"}, {"start": 5.96, "end": 6.3, "text": "falling"}, {"start": 6.3, "end": 6.7, "text": "around"}, {"start": 6.7, "end": 7.42, "text": "2012."}, {"start": 8.3, "end": 8.4, "text": "That"}, {"start": 8.4, "end": 8.56, "text": "was"}, {"start": 8.56, "end": 8.82, "text": "about"}, {"start": 8.82, "end": 9.1, "text": "three"}, {"start": 9.1, "end": 9.36, "text": "years"}, {"start": 9.36, "end": 9.7, "text": "before"}, {"start": 9.7, "end": 10.0, "text": "Port"}, {"start": 10.0, "end": 10.24, "text": "and"}, {"start": 10.24, "end": 10.78, "text": "Starboard"}, {"start": 10.78, "end": 11.0, "text": "were"}, {"start": 11.0, "end": 11.28, "text": "first"}, {"start": 11.28, "end": 11.54, "text": "seen"}, {"start": 11.54, "end": 11.82, "text": "hunting"}, {"start": 11.82, "end": 12.18, "text": "there."}], "fallback": false}