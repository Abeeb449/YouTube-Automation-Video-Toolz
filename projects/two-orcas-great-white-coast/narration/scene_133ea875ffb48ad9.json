{"duration": 10.02, "cues": [{"start": 0.0, "end": 5.28, "text": "Biologist Salvador Jorgensen, who led\nthe Farallon study, was part of that"}, {"start": 5.28, "end": 10.02, "text": "team. He says young sharks may simply\nhave no experience of orcas yet."}], "words": [{"start": 0.0, "end": 0.62, "text": "Biologist"}, {"start": 0.62, "end": 1.1, "text": "Salvador"}, {"start": 1.1, "end": 2.2, "text": "Jorgensen,"}, {"start": 2.66, "end": 2.76, "text": "who"}, {"start": 2.76, "end": 3.0, "text": "led"}, {"start": 3.0, "end": 3.16, "text": "the"}, {"start": 3.16, "end": 3.7, "text": "Farallon"}, {"start": 3.7, "end": 4.14, "text": "study,"}, {"start": 4.54, "end": 4.64, "text": "was"}, {"start": 4.64, "end": 4.92, "text": "part"}, {"start": 4.92, "end": 5.12, "text": "of"}, {"start": 5.12, "end": 5.28, "text": "that"}, {"start": 5.28, "end": 5.66, "text": "team."}, {"start": 6.02, "end": 6.12, "text": "He"}, {"start": 6.12, "end": 6.34, "text": "says"}, {"start": 6.34, "end": 6.64, "text": "young"}, {"start": 6.64, "end": 7.08, "text": "sharks"}, {"start": 7.08, "end": 7.44, "text": "may"}, {"start": 7.44, "end": 7.84, "text": "simply"}, {"start": 7.84, "end": 8.1, "text": "have"}, {"start": 8.1, "end": 8.3, "text": "no"}, {"start": 8.3, "end": 8.74, "text": "experience"}, {"start": 8.74, "end": 9.16, "text": "of"}, {"start": 9.16, "end": 9.58, "text": "orcas"}, {"start": 9.58, "end": 9.82, "text": "yet."}], "fallback": false}